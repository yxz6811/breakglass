# 复制成 .env 再填。.env 不要提交、不要发群里。

# OpenAI 兼容接口的根地址（到 /v1 这一层，不带 /chat/completions）。
# 例：https://api.openai.com/v1
#     https://dashscope.aliyuncs.com/compatible-mode/v1
#     https://open.bigmodel.cn/api/paas/v4
READER_BASE_URL=

# 服务商给的密钥，只留在这台机器上。
READER_API_KEY=

# 必须是能看图片的模型，型号以服务商文档为准。
# 例：gpt-4o、qwen-vl-max、glm-4v-plus
READER_MODEL=

# 服务商支持 response_format: json_object 时可以设成 1。
READER_JSON_MODE=0

# 只听本机。
READER_HOST=127.0.0.1
READER_PORT=8787

# 单帧等模型的上限，和整次阅读的总预算（毫秒）。总预算会被压到页面 300 秒截止之前。
READER_MODEL_TIMEOUT_MS=60000
READER_BUDGET_MS=240000

# 同时问模型的帧数。
READER_CONCURRENCY=2

# 留空时放行任意 chrome-extension:// 页面和 http://127.0.0.1、http://localhost。
# 想只放行自己装的扩展，写成 chrome-extension://<扩展编号>，多个用逗号隔开。
READER_ALLOW_ORIGINS=

# BreakGlass 的 extension 目录，相对本目录。服务用里面的 reading.js 自检。
BREAKGLASS_EXTENSION_DIR=../extension
