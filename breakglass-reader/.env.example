# 复制成 .env 再填。.env 不要提交、不要发群里。

# OpenAI 兼容接口的根地址（到 /v1 这一层，不带 /chat/completions）。
# 例：https://api.openai.com/v1
#     https://dashscope.aliyuncs.com/compatible-mode/v1
#     https://open.bigmodel.cn/api/paas/v4
READER_BASE_URL=

# 服务商给的密钥，只留在这台机器上。
READER_API_KEY=

# 必须是能看图片的模型，型号以服务商文档为准。
# 例：gpt-4o、qwen-vl-max、glm-4.6v-flash
READER_MODEL=

# 留空时：智谱地址会自动带上另外两款免费视觉模型
# glm-4v-flash、glm-4.1v-thinking-flash，和上面这个模型轮询。
# 写了就只用这一行，逗号分隔，仍共用上面的密钥。付费型号不要写进来。
# READER_MODEL_POOL=glm-4.6v-flash,glm-4v-flash,glm-4.1v-thinking-flash

# 可选的其他免费视觉接口。每一项是「型号|基址|密钥环境变量名」，多个用逗号隔开。
# 对应的密钥没填就跳过，不会发请求。密钥只写在环境变量里，不要写进这个文件的值。
# Gemini 免费档：https://aistudio.google.com/apikey
#   gemini-2.5-flash|https://generativelanguage.googleapis.com/v1beta/openai|GEMINI_API_KEY
# OpenRouter 带 :free 的视觉模型：https://openrouter.ai/keys
#   qwen/qwen3.8-27b:free|https://openrouter.ai/api/v1|OPENROUTER_API_KEY
# READER_EXTRA_MODELS=

# 服务商支持 response_format: json_object 时可以设成 1。
READER_JSON_MODE=0

# 只听本机。
READER_HOST=127.0.0.1
READER_PORT=8787

# 单帧等模型的上限，和整次阅读的总预算（毫秒）。总预算会被压到页面 300 秒截止之前。
READER_MODEL_TIMEOUT_MS=60000
READER_BUDGET_MS=240000

# 005独立开发预算（毫秒），不改变/read或1500ms抛物线保底。
# 允许1000～120000整数；无效值回到30000/10000。待真实视频测试后冻结。
READER_GEOMETRY_READ_BUDGET_MS=30000
READER_GEOMETRY_ASK_BUDGET_MS=10000

# 同时问模型的帧数。
READER_CONCURRENCY=2

# 留空时放行任意 chrome-extension:// 页面和 http://127.0.0.1、http://localhost。
# 想只放行自己装的扩展，写成 chrome-extension://<扩展编号>，多个用逗号隔开。
READER_ALLOW_ORIGINS=

# BreakGlass 的 extension 目录，相对本目录。服务用里面的 reading.js 自检。
BREAKGLASS_EXTENSION_DIR=../extension
