      ],
      "misconceptionCandidates": [
        { "id": "p-sign", "label": "括号符号与横坐标可能混淆", "answerTrigger": { "stageId": "p-practice-plus3", "answer": { "h": 3, "k": -1 } }, "confirmationPrompt": "你刚才是否把x+3中的+3直接写成了横坐标？可以确认、改成别的原因或保持待确认。", "feedback": "先解x+3=0，再读顶点；只凭这个答案不能断定原因。", "practiceStageId": "p-transfer-expanded-vertex" },
        { "id": "p-coordinate-order", "label": "横纵坐标次序可能混淆", "answerTrigger": { "stageId": "p-practice-plus3", "answer": { "h": -1, "k": -3 } }, "confirmationPrompt": "你是否将横坐标和纵坐标的顺序交换了？若不是，可修改原因或保留待确认。", "feedback": "坐标按(x,y)写。先由平方项找x，再把x代回求y。", "practiceStageId": "p-transfer-expanded-vertex" },
        { "id": "p-expanded-constant", "label": "展开式常数与顶点高度可能混淆", "answerTrigger": { "stageId": "p-transfer-expanded-vertex", "answer": { "h": -2, "k": 7 } }, "confirmationPrompt": "你是否把展开式里的7当成了顶点高度？这只是候选，可确认、修改或暂不确定。", "feedback": "常数7是x=0时的y；配方后顶点高度为3。把两种表征展开核对。", "practiceStageId": "p-transfer-expand-coefficients" }
