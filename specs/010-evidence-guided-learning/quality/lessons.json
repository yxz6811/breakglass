    {
      "id": "010-parabola-translation",
      "title": "抛物线水平平移与表征转换",
      "template": "parabola",
      "sourceId": "media-parabola-k1",
      "sourceSnapshot": { "a": 1, "h": 0, "k": 1 },
      "manualBaseline": {
        "sourceId": "manual-parabola-k0",
        "snapshot": { "a": 1, "h": 0, "k": 0 },
        "reason": "先显示原帧y=x²+1。学习者明确进入手工探索，复制后仅将k改成0；本课后续的右移示例以手工y=x²为基线。"
      },
      "shortExplanation": "在y=a(x−h)²+k且a≠0、x取全体实数时，平方项在x=h处为0，顶点为(h,k)。仅改变h时整条曲线水平平移，a和k保持不变。x+3等于x−(−3)，所以横坐标是−3。",
      "fixedConditions": ["比较水平平移时a=1且k=0固定。", "顶点读取使用a≠0；a>0时顶点是最低点，a<0时是最高点。", "这里定义域为全体实数；受限定义域上的最值要另核对端点和顶点是否在域内。", "坐标顺序为(x,y)，图上纵轴正向向上；手工练习不改媒体源数据。"],
      "stages": [
        {
          "id": "p-predict-right2",
          "stage": "prediction",
          "sourceId": "manual-parabola-k0",
          "exerciseKind": "vertex",
          "prompt": "从手工y=x²出发，只将h由0调到2，a=1和k=0不变。先预测新顶点坐标，再观察图形。",
          "snapshot": { "a": 1, "h": 2, "k": 0 },
          "math": { "representation": "vertex", "original": { "a": 1, "h": 0, "k": 0 }, "changedParameter": "h" },
          "expected": { "h": 2, "k": 0 },
          "judge": { "kind": "vertex", "absTolerance": 1e-9, "relTolerance": 0 },
          "workedSteps": ["把顶点从(0,0)移动到(2,0)，整条图形右移2；高度不变。"],
          "hints": ["只比较顶点的横坐标和纵坐标分别由哪个参数决定。"],
          "evidence": "not-attempt",
          "delayDays": null
        },
        {
          "id": "p-example-right2",
          "stage": "example",
          "sourceId": "manual-parabola-k0",
          "exerciseKind": "vertex",
          "prompt": "完整例题：把y=x²的图形向右平移2，写出方程并求顶点。",
          "snapshot": { "a": 1, "h": 2, "k": 0 },
          "math": { "representation": "vertex", "original": { "a": 1, "h": 0, "k": 0 }, "translation": { "x": 2, "y": 0 } },
          "expected": { "h": 2, "k": 0 },
          "judge": { "kind": "vertex", "absTolerance": 1e-9, "relTolerance": 0 },
          "workedSteps": ["原图一点(t,t²)右移2后成为(t+2,t²)。", "新横坐标x=t+2，所以原横坐标t=x−2。", "代入原关系得到y=(x−2)²。", "平方项在x−2=0即x=2时为0，得到顶点(2,0)。"],
          "hints": [],
          "evidence": "not-attempt",
          "delayDays": null
        },
        {
          "id": "p-complete-negative-a",
          "stage": "completion",
          "sourceId": "manual-010-variants",
          "exerciseKind": "vertex",
          "prompt": "补关键步骤：y=−0.5(x−4)²+2。已知平方项为0时x−4=0，补出x与顶点坐标。",
          "snapshot": { "a": -0.5, "h": 4, "k": 2 },
          "math": { "representation": "vertex", "scaffold": "x−4=0" },
          "expected": { "h": 4, "k": 2 },
          "judge": { "kind": "vertex", "absTolerance": 1e-9, "relTolerance": 0 },
          "workedSteps": ["已给出关键等式x−4=0。", "补全后核对：x=4，y=2，顶点(4,2)；a<0，因此这里为最高点。"],
          "hints": ["解x−4=0。", "平方项为0后，只剩外面的常数2。", "坐标先写横坐标，再写纵坐标；负的a不改变这两个坐标。"],
          "evidence": "completion-assisted",
          "delayDays": null
        },
        {
          "id": "p-practice-plus3",
          "stage": "practice",
          "sourceId": "manual-010-variants",
          "exerciseKind": "vertex",
          "prompt": "独立新题：y=2(x+3)²−1的顶点坐标是多少？先提交完整坐标；可自选提示，使用后按辅助作答记录。",
          "snapshot": { "a": 2, "h": -3, "k": -1 },
          "math": { "representation": "vertex", "equation": "y=2(x+3)^2-1" },
          "expected": { "h": -3, "k": -1 },
          "judge": { "kind": "vertex", "absTolerance": 1e-9, "relTolerance": 0 },
          "workedSteps": ["提交后解析：x+3=0给出x=−3；代回得到y=−1，因此顶点是(−3,−1)。", "a=2影响开口宽窄，不改变本题顶点坐标。"],
          "hints": ["先找平方项为0时的x。", "解x+3=0，随后代回求y。", "x+3等于x−(−3)，坐标按(h,k)书写。"],
          "evidence": "eligible-actual-submission",
          "delayDays": null
        },
        {
          "id": "p-transfer-expanded-vertex",
          "stage": "delayed-transfer",
          "sourceId": "manual-010-variants",
          "exerciseKind": "vertex",
          "prompt": "建议7天后新题：y=x²+4x+7的顶点坐标是多少？提交后可用未评分文字解释它相对y=x²怎样平移；本题从展开式读条件。",
          "snapshot": { "a": 1, "h": -2, "k": 3 },
          "math": { "representation": "expanded", "coefficients": { "a": 1, "b": 4, "c": 7 } },
          "expected": { "h": -2, "k": 3 },
          "judge": { "kind": "vertex", "absTolerance": 1e-9, "relTolerance": 0 },
          "workedSteps": ["提交后解析：x²+4x+7=(x+2)²+3。", "x+2=0时x=−2、y=3，顶点(−2,3)。", "相对y=x²，向左2、向上3；若未配方，仅抄展开式常数7会读错高度。"],
          "hints": ["先把展开式改写成平方项加常数。", "x²+4x+4=(x+2)²；原式比这个平方多3。", "配方后为(x+2)²+3，再找平方项为0的坐标。"],
          "evidence": "eligible-actual-submission",
          "delayDays": 7
        },
        {
          "id": "p-transfer-expand-coefficients",
          "stage": "delayed-transfer",
          "sourceId": "manual-010-variants",
          "exerciseKind": "coefficient-conversion",
          "prompt": "另一种表征的新题：把y=−2(x−1)²+3展开为y=ax²+bx+c，分别提交(a,b,c)。这里只判展开系数；可选解释不自动评分。",
          "snapshot": { "a": -2, "h": 1, "k": 3 },
          "math": { "representation": "vertex", "equation": "y=-2(x-1)^2+3" },
          "expected": { "a": -2, "b": 4, "c": 1 },
          "judge": { "kind": "coefficient-conversion", "absTolerance": 1e-9, "relTolerance": 0 },
          "workedSteps": ["提交后解析：(x−1)²=x²−2x+1。", "乘以−2得到−2x²+4x−2，再加3得到−2x²+4x+1。", "因此(a,b,c)=(−2,4,1)。顶点高度3与展开式常数1意义不同。"],
          "hints": ["先展开括号里的平方，保留中间项。", "(x−1)²=x²−2x+1；−2要乘每一项。", "整理−2x²+4x−2+3，再读三个系数。"],
          "evidence": "eligible-actual-submission",
          "delayDays": 7
        }
      ],
      "counterexamples": [
        {
          "id": "p-counter-sign",
          "kind": "incorrect-vertex-claim",
          "sourceId": "manual-010-variants",
          "exerciseKind": "vertex",
          "prompt": "说法：y=(x+2)²+1的顶点是(2,1)。判断并核对平方项。",
