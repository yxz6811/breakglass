<script>
/* =========================================================
   1. 背景光点粒子
   ========================================================= */
(function () {
  const cv  = document.getElementById('fx');
  const ctx = cv.getContext('2d');
  let W = 0, H = 0, dpr = 1;

  const sprite = document.createElement('canvas');
  const S = 64;
  sprite.width = sprite.height = S;
  const sc = sprite.getContext('2d');
  const g = sc.createRadialGradient(S/2, S/2, 0, S/2, S/2, S/2);
  g.addColorStop(0.00, 'rgba(210,245,255,1)');
  g.addColorStop(0.16, 'rgba(130,215,255,0.92)');
  g.addColorStop(0.42, 'rgba(60,150,255,0.26)');
  g.addColorStop(1.00, 'rgba(20,80,200,0)');
  sc.fillStyle = g;
  sc.fillRect(0, 0, S, S);

  const COUNT = window.innerWidth < 720 ? 44 : 84;
  const parts = [];

  function make(fromBottom) {
    return {
      x: Math.random() * W,
      y: fromBottom ? H + Math.random() * H * 0.35 : Math.random() * H,
      r: Math.random() * 1.7 + 0.65,
      vy: -(Math.random() * 0.22 + 0.09),
      vx: (Math.random() - 0.5) * 0.14,
      base: Math.random() * 0.5 + 0.22,
      ph: Math.random() * Math.PI * 2,
      sp: Math.random() * 0.014 + 0.005,
      wob: Math.random() * 0.22 + 0.08
    };
  }

  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    W = window.innerWidth;
    H = window.innerHeight;
    cv.width  = Math.round(W * dpr);
    cv.height = Math.round(H * dpr);
    cv.style.width  = W + 'px';
    cv.style.height = H + 'px';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  resize();
  window.addEventListener('resize', resize);

  for (let i = 0; i < COUNT; i++) parts.push(make(false));

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let t = 0;

  function paint(animate) {
    ctx.clearRect(0, 0, W, H);
    ctx.globalCompositeOperation = 'lighter';

    for (let i = 0; i < parts.length; i++) {
      const p = parts[i];

      if (animate) {
        p.y += p.vy;
        p.x += p.vx + Math.sin(t * p.sp + p.ph) * p.wob * 0.12;

        if (p.y < -70) {
          const np = make(true);
          np.x = Math.random() * W;
          parts[i] = np;
          continue;
        }
      }

      const twinkle = 0.62 + 0.38 * Math.sin(t * p.sp * 2.4 + p.ph);
      const size = p.r * 7.5;

      ctx.globalAlpha = Math.max(0, p.base * (animate ? twinkle : 1));
      ctx.drawImage(sprite, p.x - size, p.y - size, size * 2, size * 2);
    }

    ctx.globalAlpha = 1;
    ctx.globalCompositeOperation = 'source-over';
  }

  if (reduce) {
    paint(false);
  } else {
    (function loop() {
      t++;
      paint(true);
      requestAnimationFrame(loop);
    })();
  }
})();


/* =========================================================
   2. 分页入场动画
   ========================================================= */
(function () {
  const pages = Array.from(document.querySelectorAll('.page'));

  if (!('IntersectionObserver' in window)) {
    pages.forEach(p => p.classList.add('in'));
    return;
  }

  const io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.intersectionRatio > 0.35) {
        e.target.classList.add('in');
      } else if (!e.isIntersecting) {
        e.target.classList.remove('in');
      }
    });
  }, { threshold: [0, 0.35, 0.6, 0.9] });

  pages.forEach(p => io.observe(p));
})();


/* =========================================================
   3. 分页指示器 / 顶部进度条 / Hero 视差
   ========================================================= */
(function () {
  const pages    = Array.from(document.querySelectorAll('.page'));
  const links    = Array.from(document.querySelectorAll('.pager a'));
  const progress = document.getElementById('progress');
  const heroInner= document.getElementById('heroInner');

  let ticking = false;

  function update() {
    const vh = window.innerHeight;

    let best = 0, bestRatio = -1;
    for (let i = 0; i < pages.length; i++) {
      const r = pages[i].getBoundingClientRect();
      const visible = Math.min(r.bottom, vh) - Math.max(r.top, 0);
      const ratio = visible / Math.min(r.height, vh);
      if (ratio > bestRatio) { bestRatio = ratio; best = i; }
    }
    for (let i = 0; i < links.length; i++) {
      links[i].classList.toggle('active', i === best);
    }

    const doc = document.documentElement;
    const max = doc.scrollHeight - vh;
    const prog = max > 0 ? Math.min(doc.scrollTop / max, 1) : 0;
    progress.style.transform = 'scaleX(' + prog + ')';

    if (heroInner) {
      const y = Math.min(window.scrollY, vh * 1.2);
      const k = y / vh;
      if (k < 1.05) {
        heroInner.style.transform =
          'translateY(' + (-k * 70) + 'px) scale(' + (1 - k * 0.05) + ')';
        heroInner.style.opacity = String(Math.max(0, 1 - k * 1.15));
        heroInner.style.pointerEvents = k > 0.6 ? 'none' : '';
      } else {
        heroInner.style.transform = '';
        heroInner.style.opacity   = '';
        heroInner.style.pointerEvents = '';
      }
    }
  }

  function onScroll() {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(function () { update(); ticking = false; });
    }
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
  window.addEventListener('load', update);

  update();
})();


/* =========================================================
   4. 实时函数图像（右侧画布）
   ========================================================= */
(function () {
  const c   = document.getElementById('plot');
  const ctx = c.getContext('2d');
  const expr= document.getElementById('expr');

  const P = { a: 1.0, b: 1.0, c: 0.0 };
  let w = 0, h = 0, dpr = 1;

  function draw() {
    if (!w || !h) return;

    const bg = ctx.createLinearGradient(0, 0, 0, h);
    bg.addColorStop(0, 'rgba(8,28,58,.92)');
    bg.addColorStop(1, 'rgba(4,13,30,.95)');
    ctx.fillStyle = bg;
    ctx.fillRect(0, 0, w, h);

    const padX = 34, padY = 26;
    const x0 = padX, x1 = w - padX;
    const y0 = padY, y1 = h - padY;
    const cx = (x0 + x1) / 2;
    const cy = (y0 + y1) / 2;

    ctx.lineWidth = 1;
    ctx.strokeStyle = 'rgba(80,160,255,.10)';
    for (let i = 0; i <= 8; i++) {
      const x = x0 + (x1 - x0) * i / 8;
      ctx.beginPath(); ctx.moveTo(x, y0); ctx.lineTo(x, y1); ctx.stroke();
    }
    for (let i = 0; i <= 4; i++) {
      const y = y0 + (y1 - y0) * i / 4;
      ctx.beginPath(); ctx.moveTo(x0, y); ctx.lineTo(x1, y); ctx.stroke();
    }

    ctx.strokeStyle = 'rgba(120,200,255,.30)';
    ctx.beginPath(); ctx.moveTo(x0, cy); ctx.lineTo(x1, cy); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(cx, y0); ctx.lineTo(cx, y1); ctx.stroke();

    const scale = ((y1 - y0) / 2) * 0.86 / 2;
    const N = 260;

    ctx.beginPath();
    for (let i = 0; i <= N; i++) {
      const u  = i / N;
      const xv = -10 + 20 * u;
      const yv = P.a * Math.sin(P.b * xv + P.c);
      const px = x0 + (x1 - x0) * u;
      const py = cy - yv * scale;
      if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
    }

    const lg = ctx.createLinearGradient(x0, 0, x1, 0);
    lg.addColorStop(0,   'rgba(50,130,255,.65)');
    lg.addColorStop(0.5, '#8ce0ff');
    lg.addColorStop(1,   'rgba(50,130,255,.65)');

    ctx.lineWidth = 2.2;
    ctx.lineJoin = 'round';
    ctx.strokeStyle = lg;
    ctx.shadowColor = 'rgba(100,210,255,.9)';
    ctx.shadowBlur = 16;
    ctx.stroke();
    ctx.shadowBlur = 0;

    const endY = cy - P.a * Math.sin(P.b * 10 + P.c) * scale;
    ctx.beginPath();
    ctx.arc(x1, endY, 3.4, 0, Math.PI * 2);
    ctx.fillStyle = '#d8f4ff';
    ctx.shadowColor = 'rgba(120,220,255,1)';
    ctx.shadowBlur = 18;
    ctx.fill();
    ctx.shadowBlur = 0;

    ctx.font = '11px ui-monospace, Menlo, Consolas, monospace';
    ctx.fillStyle = 'rgba(110,175,225,.75)';
    ctx.fillText('x ∈ [-10, 10]', x0 + 2, y1 - 6);
    ctx.textAlign = 'right';
    ctx.fillText('WASM · on-device', x1 - 2, y0 + 14);
    ctx.textAlign = 'left';
  }

  function resize() {
    const rect = c.getBoundingClientRect();
    if (!rect.width || !rect.height) return;
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    w = rect.width;
    h = rect.height;
    c.width  = Math.round(w * dpr);
    c.height = Math.round(h * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    draw();
  }

  const sa = document.getElementById('sa');
  const sb = document.getElementById('sb');
  const sc = document.getElementById('sc');
  const va = document.getElementById('va');
  const vb = document.getElementById('vb');
  const vc = document.getElementById('vc');

  function sync() {
    P.a = parseFloat(sa.value);
    P.b = parseFloat(sb.value);
    P.c = parseFloat(sc.value);

    va.textContent = P.a.toFixed(1);
    vb.textContent = P.b.toFixed(1);
    vc.textContent = P.c.toFixed(1);

    expr.textContent =
      'y = ' + P.a.toFixed(1) + ' · sin(' + P.b.toFixed(1) + 'x + ' + P.c.toFixed(1) + ')';

    draw();
  }

  [sa, sb, sc].forEach(function (el) {
    el.addEventListener('input',  sync);
    el.addEventListener('change', sync);
  });

  if ('ResizeObserver' in window) {
    new ResizeObserver(resize).observe(c);
  }
  window.addEventListener('resize', resize);
  window.addEventListener('load', function () { resize(); sync(); });

  resize();
  sync();
})();


/* =========================================================
   5. 左侧二次函数图像（静止）
   ========================================================= */
(function () {
  var cv = document.getElementById('quad');
  if (!cv) return;
  var cx = cv.getContext('2d');
  var W = 0, H = 0, dpr = 1;

  function resize() {
    var r = cv.getBoundingClientRect();
    if (!r.width || !r.height) return;
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    W = r.width; H = r.height;
    cv.width  = Math.round(W * dpr);
    cv.height = Math.round(H * dpr);
    cx.setTransform(dpr, 0, 0, dpr, 0, 0);
    draw();
  }

  function draw() {
    if (!W || !H) return;
    cx.clearRect(0, 0, W, H);

    var padX = 12, padY = 12;
    var x0 = padX, x1 = W - padX, y0 = padY, y1 = H - padY;
    var cy = (y0 + y1) / 2;
    var i, g;

    cx.lineWidth = 1;
    cx.strokeStyle = 'rgba(80,160,255,.10)';
    for (i = 0; i <= 8; i++) {
      g = x0 + (x1 - x0) * i / 8;
      cx.beginPath(); cx.moveTo(g, y0); cx.lineTo(g, y1); cx.stroke();
    }
    for (i = 0; i <= 4; i++) {
      g = y0 + (y1 - y0) * i / 4;
      cx.beginPath(); cx.moveTo(x0, g); cx.lineTo(x1, g); cx.stroke();
    }

    cx.strokeStyle = 'rgba(120,200,255,.30)';
    cx.beginPath(); cx.moveTo(x0, cy); cx.lineTo(x1, cy); cx.stroke();
    cx.beginPath(); cx.moveTo((x0 + x1) / 2, y0); cx.lineTo((x0 + x1) / 2, y1); cx.stroke();

    var A  = 0.35;
    var Hh = 0;
    var K  = -5.2;

    var yScale = (y1 - y0) / 12;
    var px = function (u) { return x0 + (x1 - x0) * u; };
    var py = function (v) { return cy - v * yScale; };

    cx.beginPath();
    var N = 240;
    for (i = 0; i <= N; i++) {
      var u  = i / N;
      var xv = -10 + 20 * u;
      var d  = xv - Hh;
      var yv = A * d * d + K;
      var X  = px(u), Y = py(yv);
      if (i === 0) cx.moveTo(X, Y); else cx.lineTo(X, Y);
    }

    var lg = cx.createLinearGradient(x0, 0, x1, 0);
    lg.addColorStop(0,   'rgba(50,130,255,.65)');
    lg.addColorStop(0.5, '#8ce0ff');
    lg.addColorStop(1,   'rgba(50,130,255,.65)');

    cx.lineWidth = 2.2;
    cx.lineJoin = 'round';
    cx.strokeStyle = lg;
    cx.shadowColor = 'rgba(100,210,255,.9)';
    cx.shadowBlur = 16;
    cx.stroke();
    cx.shadowBlur = 0;

    cx.beginPath();
    cx.arc(px((Hh + 10) / 20), py(K), 3.4, 0, Math.PI * 2);
    cx.fillStyle = '#d8f4ff';
    cx.shadowColor = 'rgba(120,220,255,1)';
    cx.shadowBlur = 18;
    cx.fill();
    cx.shadowBlur = 0;
  }

  resize();
  if ('ResizeObserver' in window) new ResizeObserver(resize).observe(cv);
  window.addEventListener('resize', resize);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(resize);
  window.addEventListener('load', resize);
})();


