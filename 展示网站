<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>破壁 BreakGlass — 让知识可以被触碰</title>
<meta name="theme-color" content="#000000" />
<style>
/* =========================================================
   破壁 BreakGlass · Apple 化重制版
   ========================================================= */
*{box-sizing:border-box;margin:0;padding:0}

:root{
  --bg:#000;
  --bg-soft:#0a0a0c;
  --text:#f5f5f7;
  --text-dim:#86868b;
  --text-strong:#fff;
  --accent:#2997ff;
  --accent-soft:#64d2ff;
  --danger:#ff6b6b;
  --line:rgba(255,255,255,.10);
  --line-soft:rgba(255,255,255,.06);
  --card:rgba(255,255,255,.045);
  --card-hover:rgba(255,255,255,.075);
  --r-lg:28px;
  --r-md:20px;
  --r-sm:14px;
  --r-pill:980px;
  --ease:cubic-bezier(.28,.11,.32,1);
  --ease-out:cubic-bezier(.22,.7,.3,1);
  --max:1080px;
  --nav-h:48px;
  --mono:ui-monospace,"SF Mono",SFMono-Regular,Menlo,Consolas,"Liberation Mono",monospace;
}

html{
  scroll-behavior:smooth;
  scroll-snap-type:y proximity;
  overflow-x:hidden;
  -webkit-text-size-adjust:100%;
}
html.detail-open{overflow:hidden}

body{
  font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","SF Pro Text",
    "PingFang SC","Helvetica Neue","Microsoft YaHei",system-ui,sans-serif;
  background:var(--bg);
  color:var(--text);
  line-height:1.5;
  letter-spacing:-.012em;
  overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
}

::selection{background:rgba(41,151,255,.35);color:#fff}
::-webkit-scrollbar{width:10px}
::-webkit-scrollbar-track{background:#000}
::-webkit-scrollbar-thumb{background:#2a2a2e;border-radius:8px;border:2px solid #000}
::-webkit-scrollbar-thumb:hover{background:#3a3a3e}

/* =========================================================
   0. 固定背景层
   ========================================================= */
.bg-core{
  position:fixed;inset:0;z-index:-4;pointer-events:none;
  background:
    radial-gradient(120% 60% at 50% 112%, rgba(41,151,255,.16) 0%, rgba(41,151,255,.05) 34%, rgba(0,0,0,0) 68%),
    radial-gradient(70% 45% at 50% -12%, rgba(41,151,255,.10) 0%, rgba(0,0,0,0) 70%),
    #000;
}
.grid-overlay{
  position:fixed;inset:0;z-index:-3;pointer-events:none;
  background-image:
    linear-gradient(rgba(255,255,255,.028) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.028) 1px, transparent 1px);
  background-size:72px 72px;
  -webkit-mask-image:radial-gradient(120% 80% at 50% 30%, #000 12%, transparent 74%);
          mask-image:radial-gradient(120% 80% at 50% 30%, #000 12%, transparent 74%);
}
#fx{position:fixed;inset:0;z-index:-2;pointer-events:none}
.topline{
  position:fixed;top:0;left:0;right:0;height:1px;z-index:38;pointer-events:none;
  background:linear-gradient(90deg,transparent,rgba(41,151,255,.35),rgba(100,210,255,.55),rgba(41,151,255,.35),transparent);
  opacity:.5;
}
.progress{
  position:fixed;top:0;left:0;height:2px;width:100%;z-index:39;
  transform-origin:0 50%;transform:scaleX(0);
  background:linear-gradient(90deg,#0071e3,#64d2ff);
  box-shadow:0 0 12px rgba(41,151,255,.7);
  pointer-events:none;
}

/* =========================================================
   1. 全局导航
   ========================================================= */
.nav{
  position:fixed;top:0;left:0;right:0;height:var(--nav-h);z-index:40;
  display:flex;align-items:center;gap:26px;
  padding:0 22px;
  background:rgba(10,10,12,.72);
  -webkit-backdrop-filter:saturate(180%) blur(20px);
          backdrop-filter:saturate(180%) blur(20px);
  border-bottom:1px solid rgba(255,255,255,.08);
}
.nav-brand{
  font-size:15px;font-weight:600;color:var(--text);text-decoration:none;
  letter-spacing:-.02em;white-space:nowrap;
}
.nav-brand span{font-size:12px;font-weight:500;color:var(--text-dim);letter-spacing:.02em;margin-left:2px}
.nav-links{display:flex;align-items:center;gap:22px;margin-left:auto}
.nav-links a{
  font-size:12px;color:var(--text-dim);text-decoration:none;
  transition:color .3s var(--ease);
}
.nav-links a:hover{color:var(--text)}
.nav-cta{
  font-size:12px;font-weight:500;color:#fff;text-decoration:none;
  padding:6px 14px;border-radius:var(--r-pill);
  background:var(--accent);
  transition:filter .3s var(--ease),transform .3s var(--ease);
}
.nav-cta:hover{filter:brightness(1.12);transform:translateY(-1px)}

/* =========================================================
   2. 分页结构
   ========================================================= */
.page{
  position:relative;
  min-height:100vh;
  min-height:100dvh;
  display:flex;align-items:center;justify-content:center;
  padding:calc(var(--nav-h) + 7vh) 26px 11vh;
  scroll-snap-align:start;
  scroll-snap-stop:normal;
}
.page-inner{width:100%;max-width:var(--max);margin:0 auto}
.page-inner.center{text-align:center}

.pager{
  position:fixed;right:24px;top:50%;transform:translateY(-50%);
  z-index:25;display:flex;flex-direction:column;gap:14px;
}
.pager a{
  position:relative;width:8px;height:8px;border-radius:50%;
  background:rgba(255,255,255,.18);
  transition:background .35s var(--ease),transform .35s var(--ease);
}
.pager a:hover{background:rgba(255,255,255,.45)}
.pager a.active{background:var(--accent);transform:scale(1.35)}
.pager a::after{
  content:attr(data-label);
  position:absolute;right:20px;top:50%;transform:translateY(-50%) translateX(6px);
  font-size:12px;color:var(--text-dim);white-space:nowrap;
  opacity:0;pointer-events:none;
  transition:opacity .3s var(--ease),transform .3s var(--ease);
}
.pager a:hover::after{opacity:1;transform:translateY(-50%) translateX(0)}

/* =========================================================
   3. 揭示动画
   ========================================================= */
.reveal{
  opacity:0;transform:translateY(30px);
  transition:opacity .95s var(--ease),transform .95s var(--ease);
  transition-delay:calc(var(--i,0) * 85ms);
}
.page.in .reveal{opacity:1;transform:none}

/* =========================================================
   4. 文字系统
   ========================================================= */
.eyebrow{
  font-size:14px;font-weight:600;letter-spacing:.10em;
  color:var(--accent);
  margin-bottom:22px;
}
.page-title{
  font-size:clamp(34px,6.2vw,76px);
  font-weight:600;
  line-height:1.06;
  letter-spacing:-.032em;
  color:var(--text-strong);
  max-width:20ch;
}
.page-inner.center .page-title{margin-left:auto;margin-right:auto}
.page-title em{
  font-style:normal;
  background:linear-gradient(92deg,#64d2ff,#2997ff 55%,#a78bfa);
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
.page-lead{
  margin-top:26px;
  font-size:clamp(17px,2.1vw,23px);
  line-height:1.55;
  color:var(--text-dim);
  max-width:44ch;
}
.page-inner.center .page-lead{margin-left:auto;margin-right:auto}
.page-lead strong{color:var(--text);font-weight:600}

/* =========================================================
   5. Hero
   ========================================================= */
.hero{text-align:center}
.hero-tag{
  display:flex;flex-wrap:wrap;gap:10px;justify-content:center;
  margin-bottom:34px;
}
.hero-title{
  font-size:clamp(56px,12vw,140px);
  font-weight:700;
  line-height:.98;
  letter-spacing:-.045em;
  color:var(--text-strong);
}
.hero-title .en{
  display:block;
  font-size:clamp(15px,2.4vw,26px);
  font-weight:500;
  letter-spacing:.12em;
  color:var(--text-dim);
  margin-top:18px;
  text-transform:uppercase;
}
.hero-sub{
  margin:30px auto 0;
  max-width:30ch;
  font-size:clamp(19px,2.7vw,30px);
  font-weight:500;
  line-height:1.35;
  letter-spacing:-.022em;
  color:var(--text);
}
.hero-desc{
  margin:20px auto 0;
  max-width:52ch;
  font-size:clamp(14px,1.5vw,17px);
  line-height:1.6;
  color:var(--text-dim);
}
.hero-actions{
  display:flex;gap:14px;justify-content:center;flex-wrap:wrap;
  margin-top:44px;
}

/* =========================================================
   6. 组件
   ========================================================= */
.pill{
  display:inline-flex;align-items:center;gap:7px;
  padding:6px 13px;border-radius:var(--r-pill);
  font-size:12px;font-weight:500;letter-spacing:.01em;
  color:var(--text-dim);
  background:rgba(255,255,255,.05);
  border:1px solid var(--line-soft);
}
.pill.live{color:var(--text)}
.pill.live i{
  width:6px;height:6px;border-radius:50%;background:#30d158;
  box-shadow:0 0 8px rgba(48,209,88,.8);
  animation:blink 2s ease-in-out infinite;
}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.25}}

.btn{
  display:inline-flex;align-items:center;justify-content:center;
  padding:14px 28px;border-radius:var(--r-pill);
  font-size:16px;font-weight:500;letter-spacing:-.01em;
  text-decoration:none;
  transition:filter .3s var(--ease),background .3s var(--ease),
             transform .3s var(--ease),border-color .3s var(--ease);
}
.btn:hover{transform:translateY(-2px)}
.btn.primary{background:var(--accent);color:#fff}
.btn.primary:hover{filter:brightness(1.12)}
.btn.ghost{color:var(--accent);border:1px solid rgba(41,151,255,.55)}
.btn.ghost:hover{background:rgba(41,151,255,.12)}

.card{
  position:relative;
  background:var(--card);
  border:1px solid var(--line-soft);
  border-radius:var(--r-lg);
  padding:32px;
  transition:background .4s var(--ease),transform .4s var(--ease);
}
.card:hover{background:var(--card-hover);transform:translateY(-3px)}
.card-head{display:flex;align-items:center;gap:12px;margin-bottom:22px}
.card-head .ico{font-size:22px;line-height:1}
.card-head h2{font-size:20px;font-weight:600;letter-spacing:-.02em}

/* =========================================================
   7. Page 2 · 流程
   ========================================================= */
.flow{
  display:flex;flex-wrap:wrap;align-items:center;justify-content:center;
  gap:12px;margin-top:52px;
}
.flow-item{
  padding:14px 20px;border-radius:var(--r-md);
  font-size:15px;color:var(--text);
  background:var(--card);
  border:1px solid var(--line-soft);
  transition:transform .35s var(--ease),background .35s var(--ease);
}
.flow-item:hover{transform:translateY(-2px);background:var(--card-hover)}
.flow-item.bad{
  color:#ffb4b4;
  background:rgba(255,107,107,.10);
  border-color:rgba(255,107,107,.28);
}
.flow-arrow{color:var(--text-dim);font-size:16px}

/* =========================================================
   8. Page 3 · 方案分栏
   ========================================================= */
.sol-split{
  display:grid;grid-template-columns:1fr 1fr;gap:52px;
  align-items:start;margin-top:56px;
}
.sol-split>*,.demo-grid>*,.split>*{min-width:0}
.sol-point h3{
  display:flex;align-items:center;gap:11px;
  font-size:21px;font-weight:600;letter-spacing:-.022em;
  margin-bottom:16px;
}
.sol-point h3 .dot{
  width:8px;height:8px;border-radius:50%;background:var(--accent);
  box-shadow:0 0 12px rgba(41,151,255,.9);
  flex:none;
}
.sol-point p{color:var(--text-dim);font-size:16px;line-height:1.62}
.sol-point ul{list-style:none;margin-top:26px;display:grid;gap:12px}
.sol-point ul li{
  position:relative;padding-left:26px;
  font-size:15px;color:var(--text);
}
.sol-point ul li::before{
  content:"";position:absolute;left:4px;top:.55em;
  width:7px;height:7px;border-radius:2px;
  background:var(--accent);opacity:.85;
}

.mini-term{
  border-radius:var(--r-md);overflow:hidden;
  background:#0d0d0f;
  border:1px solid var(--line);
  box-shadow:0 24px 60px rgba(0,0,0,.6);
}
.mt-bar{
  display:flex;align-items:center;gap:7px;
  padding:12px 16px;
  background:rgba(255,255,255,.035);
  border-bottom:1px solid var(--line-soft);
}
.mt-bar i{width:10px;height:10px;border-radius:50%;background:#3a3a3e}
.mt-bar i:nth-child(1){background:#ff5f57}
.mt-bar i:nth-child(2){background:#febc2e}
.mt-bar i:nth-child(3){background:#28c840}
.mt-bar span{
  margin-left:8px;font-size:12px;color:var(--text-dim);
  font-family:var(--mono);
}
.mini-term pre{
  padding:22px;margin:0;
  font-family:var(--mono);
  font-size:13.5px;line-height:1.85;
  color:#d7d7da;
  overflow-x:auto;
  white-space:pre;
}
.mini-term .c1{color:#ff9f0a}
.mt-run{
  padding:13px 20px;
  font-family:var(--mono);font-size:12.5px;
  color:var(--accent-soft);
  background:rgba(41,151,255,.07);
  border-top:1px solid var(--line-soft);
}

/* =========================================================
   9. Page 4 · 价值卡
   ========================================================= */
.values{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:56px}
.value{
  display:flex;gap:18px;align-items:flex-start;
  padding:30px 26px;
  background:var(--card);
  border:1px solid var(--line-soft);
  border-radius:var(--r-lg);
  transition:background .45s var(--ease),transform .45s var(--ease),border-color .45s var(--ease);
}
.value:hover{
  background:var(--card-hover);
  border-color:rgba(41,151,255,.35);
  transform:translateY(-5px);
}
.value .v-ico{font-size:26px;line-height:1;flex:none}
.value h3{font-size:19px;font-weight:600;letter-spacing:-.022em;margin-bottom:9px}
.value p{font-size:14.5px;line-height:1.6;color:var(--text-dim)}
.value .en{
  display:block;margin-top:14px;
  font-size:11px;font-weight:600;letter-spacing:.12em;
  color:rgba(41,151,255,.75);
}

/* =========================================================
   10. Page 5 · 实时演示
   ========================================================= */
.demo-head{
  display:flex;align-items:center;justify-content:space-between;
  gap:20px;flex-wrap:wrap;
}
.status{
  display:inline-flex;align-items:center;gap:8px;
  padding:6px 14px;border-radius:var(--r-pill);
  font-size:12px;font-weight:600;letter-spacing:.06em;
  color:#30d158;
  background:rgba(48,209,88,.10);
  border:1px solid rgba(48,209,88,.28);
}
.status i{
  width:6px;height:6px;border-radius:50%;background:#30d158;
  box-shadow:0 0 8px rgba(48,209,88,.9);
  animation:blink 2s ease-in-out infinite;
}

.demo-grid{
  display:grid;grid-template-columns:1fr 1fr;gap:24px;
  margin-top:48px;align-items:stretch;
}

.stage{
  border-radius:var(--r-md);overflow:hidden;
  background:#0b0b0d;
  border:1px solid var(--line);
  display:flex;flex-direction:column;
}
.stage-bar{
  display:flex;align-items:center;gap:12px;
  padding:12px 16px;
  background:rgba(255,255,255,.035);
  border-bottom:1px solid var(--line-soft);
}
.dots{display:flex;gap:6px}
.dots i{width:9px;height:9px;border-radius:50%;background:#3a3a3e}
.stage-name{font-size:12px;color:var(--text-dim);font-family:var(--mono);flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.stage-time{font-size:12px;color:var(--text-dim);font-family:var(--mono)}
.stage-body{flex:1;position:relative}

.fake-video{
  position:relative;height:100%;min-height:300px;
  padding:24px 24px 84px;overflow:hidden;
  display:flex;flex-direction:column;
  background:radial-gradient(90% 70% at 50% 40%,#141418,#0a0a0c 75%);
}
.scan{
  position:absolute;left:0;right:0;height:100px;top:-100px;
  background:linear-gradient(180deg,transparent,rgba(41,151,255,.16),transparent);
  animation:scan 4.5s linear infinite;
  pointer-events:none;
}
@keyframes scan{0%{top:-100px}100%{top:100%}}

.code-block{
  position:relative;z-index:1;
  font-family:var(--mono);
  font-size:13px;line-height:1.9;
  color:#e2e2e6;
  white-space:pre-wrap;
}
.code-block .cm{color:#6e6e73}
.code-block .k{color:#ff7ab6}
.code-block .n{color:#64d2ff}

.handler{
  position:absolute;right:22px;bottom:74px;
  width:16px;height:16px;border-radius:50%;
  background:var(--accent);
  box-shadow:0 0 0 6px rgba(41,151,255,.16),0 0 22px rgba(41,151,255,.9);
  animation:pulse 2.4s ease-in-out infinite;
}
@keyframes pulse{
  0%,100%{box-shadow:0 0 0 6px rgba(41,151,255,.16),0 0 22px rgba(41,151,255,.9)}
  50%{box-shadow:0 0 0 13px rgba(41,151,255,.05),0 0 30px rgba(41,151,255,1)}
}

.inject-chip{
  position:absolute;left:22px;bottom:22px;z-index:1;
  padding:7px 15px;border-radius:var(--r-pill);
  font-size:12px;color:var(--text);
  background:rgba(41,151,255,.14);
  border:1px solid rgba(41,151,255,.42);
  -webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);
}

.fn-preview{
  position:relative;
  flex:1 1 auto;
  min-height:158px;
  border-radius:14px;
  border:1px dashed rgba(41,151,255,.42);
  background:
    radial-gradient(95% 85% at 50% 108%, rgba(41,151,255,.12), rgba(0,0,0,0) 72%),
    rgba(8,16,32,.5);
  overflow:hidden;
}
.code-block ~ .fn-preview{ margin-top:20px }
.fn-preview canvas{position:absolute;inset:0;width:100%;height:100%;display:block}
.fn-badge{
  position:absolute;top:9px;left:12px;
  font-family:var(--mono);font-size:10.5px;letter-spacing:.05em;
  color:var(--accent-soft);pointer-events:none;
}
.fn-note{
  position:absolute;top:9px;right:12px;
  font-family:var(--mono);font-size:10.5px;
  color:var(--text-dim);pointer-events:none;
}
.fn-note b{color:var(--accent-soft);font-weight:500}

.live{
  display:flex;flex-direction:column;
  padding:24px;
  background:var(--card);
  border:1px solid var(--line);
  border-radius:var(--r-md);
}
.live-head{
  display:flex;align-items:center;justify-content:space-between;
  gap:14px;flex-wrap:wrap;
  font-size:13px;color:var(--text-dim);
}
#expr{font-family:var(--mono);color:var(--accent-soft);font-size:13px}
#plot{
  width:100%;height:min(38vh,280px);
  display:block;margin:18px 0 6px;
  border-radius:var(--r-sm);
  background:rgba(255,255,255,.02);
}
.controls{display:grid;gap:14px;margin-top:8px}
.controls label{
  display:grid;grid-template-columns:88px 1fr 44px;
  align-items:center;gap:14px;
  font-size:13px;color:var(--text-dim);
}
.controls label b{
  font-family:var(--mono);font-size:13px;font-weight:500;
  color:var(--text);text-align:right;
}
input[type=range]{
  -webkit-appearance:none;appearance:none;
  width:100%;height:4px;border-radius:var(--r-pill);
  background:rgba(255,255,255,.16);outline:none;cursor:pointer;
}
input[type=range]::-webkit-slider-thumb{
  -webkit-appearance:none;
  width:18px;height:18px;border-radius:50%;
  background:#fff;border:none;cursor:pointer;
  box-shadow:0 1px 6px rgba(0,0,0,.6);
  transition:transform .2s var(--ease);
}
input[type=range]::-webkit-slider-thumb:hover{transform:scale(1.12)}
input[type=range]::-moz-range-thumb{
  width:18px;height:18px;border:none;border-radius:50%;background:#fff;cursor:pointer;
}
.console-line{
  margin-top:auto;padding-top:18px;
  font-family:var(--mono);font-size:12px;
  color:var(--text-dim);
}

/* =========================================================
   11. Page 6 · 系统技术架构 —— 极简卡片 + 点击放大
   ========================================================= */

/* ---- 卡片：初始只显示「编号 + 标题」 ---- */
.step{
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:12px;
  min-height:150px;
  padding:28px 16px;
  text-align:center;
  background:var(--card);
  border:1px solid var(--line-soft);
  border-radius:var(--r-lg);
  cursor:pointer;
  outline:none;
  -webkit-tap-highlight-color:transparent;
  transition:background .4s var(--ease),
             border-color .4s var(--ease),
             transform .4s var(--ease),
             box-shadow .4s var(--ease);
}
.step:hover{
  background:var(--card-hover);
  border-color:rgba(41,151,255,.55);
  transform:translateY(-6px);
  box-shadow:0 26px 60px rgba(0,0,0,.55),
             0 0 0 1px rgba(41,151,255,.15);
}
.step:focus-visible{
  border-color:rgba(41,151,255,.75);
